# Production Backend API URL (omit trailing slash, includes /api)
# For Unified Custom Domain deployment (majesticblazer.com), this can be set to /api or left unset
# (The application automatically detects window.location.hostname === 'majesticblazer.com' and uses /api)
# For standalone Vercel preview/production fallback:
VITE_API_URL=https://majestic-blazer-production.up.railway.app/api

# Customer Storefront URL (used for "Return to Storefront", "View Boutique", and customer session redirects)
# For Unified Custom Domain: defaults to https://majesticblazer.com
# For standalone Vercel fallback: https://majestic-blazer.vercel.app
# Precedence: VITE_CUSTOMER_APP_URL -> VITE_STOREFRONT_URL -> Host-based detection -> Fallback
VITE_CUSTOMER_APP_URL=https://majestic-blazer.vercel.app
VITE_STOREFRONT_URL=https://majestic-blazer.vercel.app
