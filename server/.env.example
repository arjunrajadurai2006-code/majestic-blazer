# Majestic Blazer Backend Environment Variables
NODE_ENV=production
PORT=5000

# Allowed Frontend Origins (comma-separated or specify CLIENT_URL and ADMIN_URL)
CLIENT_URL=https://majesticblazer.com
ADMIN_URL=https://admin.majesticblazer.com
CORS_ORIGINS=https://majesticblazer.com,https://admin.majesticblazer.com,http://localhost:5173,http://localhost:5174

# Database Connection (Option A: DATABASE_URL, Option B: individual DB_* variables)
# Option A: Full Connection String (Railway / Cloud standard)
# DATABASE_URL=postgres://avnadmin:PASSWORD@your-aiven-host.aivencloud.com:11497/defaultdb?sslmode=require

# Option B: Individual Connection Parameters
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=11497
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb
DB_SSL=true

# Aiven Cloud SSL Certificate
# Specify file path (DB_SSL_CA_PATH) or paste PEM certificate string / base64 directly (DB_SSL_CA)
DB_SSL_CA_PATH=aiven-ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT Authentication (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Leave empty for simulated checkout testing, or fill in from Razorpay Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE=false

# Used ONLY by `npm run create-admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
