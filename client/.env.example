# Production Backend API URL (omit trailing slash, includes /api)
# For Unified Custom Domain deployment (majesticblazer.com), this can be set to /api or left unset
# (The application automatically detects window.location.hostname === 'majesticblazer.com' and uses /api)
# For standalone Vercel preview/production fallback:
VITE_API_URL=https://majestic-blazer-production.up.railway.app/api

# Deployed Admin Operations Portal URL
# For Unified Custom Domain: defaults to https://majesticblazer.com/admin
# For standalone Vercel fallback: https://majestic-blazer-miup.vercel.app
# Precedence: VITE_ADMIN_APP_URL -> VITE_ADMIN_URL -> Host-based detection -> Fallback
VITE_ADMIN_APP_URL=https://majestic-blazer-miup.vercel.app
VITE_ADMIN_URL=https://majestic-blazer-miup.vercel.app

# Optional Razorpay Key for customer checkout
VITE_RAZORPAY_KEY_ID=
